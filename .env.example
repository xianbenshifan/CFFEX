# 本机配置。此文件不入库（已被 .gitignore 忽略），可以放心填真实值。
# 取值优先级：真实环境变量 > 本文件 > 代码默认值。
# 改完需重启 proxy_server.py 生效。

# ===== 大模型（DeepSeek 官方，唯一平台）=====
# 必填。未填时跳过 llm_api 兜底，本地题库与语义检索不受影响。
DEEPSEEK_API_KEY=

# 模型名。deepseek-flash 即 DeepSeek-V4.1-Flash-1017，一般不用改。
LLM_MODEL=deepseek-flash

# 接口地址。只有换私有网关时才需要改。
LLM_API_BASE=https://api.deepseek.com/v1

# 单次请求超时（秒）。
LLM_TIMEOUT=30

# ===== 答案路由 =====
# 本地语义检索的相似度阈值，低于此值才交给大模型。
LOCAL_MATCH_THRESHOLD=0.82

# 本地推理索引是 0 基；服务器内部序号从 1 开始，故默认按 1 基提交。
# 若实测发现该接口接受 0 基（提交后 correct 全为 false），改成 0。
SUBMIT_INDEX_BASE=1

# ===== 抓包与答题 =====
# 收到抓包后是否自动走完整答题编排（含提交答案）。
AUTO_SUBMIT=1

# 是否允许直接 HTTP 提交答案。MCP 只负责收题，提交一律走直连。
ALLOW_DIRECT_SUBMIT=1

# 单轮最多连续处理多少道题。
MAX_AUTO_QUESTIONS=100

# ===== 提交网络 =====
# 提交答案时走的代理。留空表示直连目标站点。
# 需要经 Charles 观察提交请求时填 http://127.0.0.1:8888
SUBMIT_PROXY_URL=

# 是否校验 TLS 证书。0 关闭校验。
VERIFY_TLS=0

# ===== 服务 =====
# 绑定 0.0.0.0 以便其他设备直接访问；访问用主机 IP 加端口。
PROXY_HOST=0.0.0.0
PROXY_PORT=8889

# ===== Charles MCP（HTTP 传输）=====
# 由 charles_mcp_http.py 提供的端点。留空则用默认值。
CHARLES_MCP_URL=http://127.0.0.1:8931/mcp

# HTTP MCP 服务自身监听的地址与端口。
CHARLES_MCP_HTTP_HOST=127.0.0.1
CHARLES_MCP_HTTP_PORT=8931

# Charles Web API 的认证信息。
CHARLES_USER=admin
CHARLES_PASS=123456

# 收题轮询间隔（秒）。MCP 只提供查询接口、没有推送，因此靠轮询发现新题。
# 实测单次查询约 0.21 秒，可设到 0.5 甚至更低；运行中改这个不会生效，
# 需要用 POST /mcp/capture/interval 动态调整。
MCP_POLL_INTERVAL=1

# ===== 答题记录 Markdown =====
# 留空则写到 capture_data/答题记录.md
ANSWER_MD_PATH=
