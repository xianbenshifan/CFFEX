# 本机配置。此文件不入库（已被 .gitignore 忽略），可以放心填真实值。
# 取值优先级：真实环境变量 > 本文件 > 代码默认值。
# 改完需重启 proxy_server.py 生效。

# ===== 大模型（DeepSeek 官方，唯一平台）=====
# 必填。未填时跳过 llm_api 兜底，本地题库与语义检索不受影响。
DEEPSEEK_API_KEY=

# 模型名。deepseek-flash 即 DeepSeek-V4.1-Flash-1017，一般不用改。
LLM_MODEL=deepseek-flash

# 接口地址。只有换私有网关时才需要改。
LLM_API_BASE=https://api.deepseek.com/v1

# 单次请求硬超时（秒）。超过就不等大模型，只保留题库侧答案。
# 实测 reasoning_effort=low 时最慢 2.6 秒，8 秒留足余量。
LLM_TIMEOUT=8

# 推理深度。low 比默认快 1.4 倍且实测准确率不变；设空则用平台默认。
LLM_REASONING_EFFORT=low

# ===== 答案路由 =====
# 题库语义结果的采用门槛（不只是"交给大模型"的阈值）。
# 实测 0.6~0.85 区间常有跨考点误配（把期权的题匹到期指的题），
# 因此必须达到这个更严的值、且题干实质相同才会采用题库答案。
SEMANTIC_MIN_SIMILARITY=0.95

# 旧的宽松阈值，保留给其他调用方。
LOCAL_MATCH_THRESHOLD=0.82

# 本地推理索引是 0 基；服务器内部序号从 1 开始，故默认按 1 基提交。
# 若实测发现该接口接受 0 基（提交后 correct 全为 false），改成 0。
SUBMIT_INDEX_BASE=1

# ===== 抓包与答题 =====
# 收到抓包后自动解析题目、给出题库与大模型两份答案，但不提交。
# 是否提交由人手动决定，脚本不会自动提交任何答案。
#
# 下方两项保留给手动提交脚本使用，自动流程不读取。
ALLOW_DIRECT_SUBMIT=1

# 单轮最多连续处理多少道题。
MAX_AUTO_QUESTIONS=100

# ===== 提交网络 =====
# 提交答案时走的代理。留空表示直连目标站点。
# 需要经 Charles 观察提交请求时填 http://127.0.0.1:8888
SUBMIT_PROXY_URL=

# 是否校验 TLS 证书。0 关闭校验。
VERIFY_TLS=0

# ===== 服务 =====
# 绑定 0.0.0.0 以便其他设备直接访问；访问用主机 IP 加端口。
PROXY_HOST=0.0.0.0
PROXY_PORT=8889

# ===== Charles MCP（HTTP 传输）=====
# 由 charles_mcp_http.py 提供的端点。留空则用默认值。
CHARLES_MCP_URL=http://127.0.0.1:8931/mcp

# HTTP MCP 服务自身监听的地址与端口。
CHARLES_MCP_HTTP_HOST=127.0.0.1
CHARLES_MCP_HTTP_PORT=8931

# Charles Web API 的认证信息。
CHARLES_USER=admin
CHARLES_PASS=123456

# ===== mitmproxy 收题 =====
# 与 Charles 并列。手机代理指向本机此端口，只解密答题域名。
# 命中的题目和答案会推到 MITM_CAPTURE_URL，答题服务仍是 8889。
MITM_LISTEN_HOST=0.0.0.0
# 与 Charles 的 HTTP 代理端口相同，手机不用改端口。同一时刻只能有一个程序听这个端口。
MITM_LISTEN_PORT=8888
MITM_CAPTURE_URL=http://127.0.0.1:8889/mcp/charles/capture
MITM_ALLOW_HOSTS=quiz-activity\.eastmoney\.com

# 收题轮询间隔（秒）。MCP 只提供查询接口、没有推送，因此靠轮询发现新题。
# 每一轮都会新建一次 MCP 会话，日志里会连续出现几条 HTTP 请求。
# 默认 1 秒一轮。运行中改这个不会生效，需要用 POST /mcp/capture/interval 动态调整。
MCP_POLL_INTERVAL=1

# ===== 答题记录 Markdown =====
# 留空则写到 capture_data/答题记录.md
ANSWER_MD_PATH=
